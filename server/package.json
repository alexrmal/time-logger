{
  "name": "personal-efficiency-dashboard-server",
  "version": "1.0.0",
  "description": "Express REST API for Personal Efficiency Dashboard",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js index.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .js --ignore-pattern node_modules --max-warnings 0",
    "test": "NODE_ENV=test node ./node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"]
  }
}
